<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0a0f14">
  <title>Konsol Tim Penyerang | GARUDA SHIELD</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/konsol.css">
</head>
<body>
  <div class="progress-bar" id="progress-bar" aria-hidden="true"></div>

  <div class="sim-ribbon"><span class="ribbon-dot"></span> SIMULASI DEFENSIF · SERANGAN TIDAK NYATA · TARGET ADALAH SITUS DUMMY LOKAL</div>

  <header class="console-header">
    <div class="header-inner">
      <a class="console-brand" href="/">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M24 4 42 11v12c0 11-7 18-18 22C13 41 6 34 6 23V11z"/><path d="m15 25 6 6 13-15"/></svg></span>
        <span class="brand-copy"><strong>GARUDA<span>SHIELD</span></strong><small>RED TEAM CONSOLE / SIMULASI</small></span>
      </a>
      <div class="header-tools">
        <span class="header-clock"><span class="clock-label">WAKTU SIM</span><strong id="clock"><%= checkedAt %></strong></span>
        <a class="ghost-link" href="/">Dashboard <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </header>

  <main class="console-main">
    <section class="intro">
      <div>
        <p class="eyebrow">KONSOL TIM PENYERANG / PENGUJIAN PERTAHANAN</p>
        <h1>Simulasikan serangan, uji <em>penangkalan</em>.</h1>
        <p class="intro-copy">Pilih target dummy, pilih metode, lalu luncurkan. Target terbuka di jendela baru dan modul pertahanan GARUDA SHIELD menampilkan deteksi serta respons otomatis.</p>
      </div>
      <div class="safety-chip"><span class="safety-glyph">⚠</span><span><strong>AMAN &amp; TERKENDALI</strong><small>Hanya event simulasi lokal</small></span></div>
    </section>

    <section class="console-grid">
      <section class="panel target-panel">
        <div class="panel-head">
          <div><span class="section-index">01 / TARGET</span><h2>Pilih target</h2></div>
          <span class="panel-count" id="target-count"><%= kodamSites.length %></span>
        </div>
        <label class="search-field"><span aria-hidden="true">⌕</span><input id="target-search" type="search" placeholder="Cari Kodam atau kota" autocomplete="off" aria-label="Cari target"><kbd>/</kbd></label>
        <div class="target-list" id="target-list">
          <% kodamSites.forEach((site) => { %>
            <button class="target-option" type="button" data-site-id="<%= site.id %>" data-site-name="<%= site.name %>" data-site-code="<%= site.code %>" data-site-city="<%= site.city %>" data-site-status="<%= site.status %>" data-name="<%= site.name %> <%= site.city %>">
              <span class="target-dot status-<%= site.status %>"></span>
              <span class="target-copy"><strong><%= site.name %></strong><small><%= site.city %> <span>·</span> <%= site.code %></small></span>
              <span class="target-meta"><%= site.latency === null ? '—' : `${site.latency} ms` %></span>
              <span class="target-check" aria-hidden="true">✓</span>
            </button>
          <% }) %>
          <div class="target-empty" id="target-empty" hidden>Tidak ada target yang cocok.</div>
        </div>
      </section>

      <section class="panel method-panel">
        <div class="panel-head">
          <div><span class="section-index">02 / METODE</span><h2>Modul pertahanan diuji</h2></div>
          <span class="panel-count"><%= methods.length %></span>
        </div>
        <div class="method-grid">
          <% methods.forEach((method) => { %>
            <button class="method-card" type="button" data-method-id="<%= method.id %>" data-method-code="<%= method.code %>" data-method-name="<%= method.name %>">
              <span class="method-top"><span class="method-code"><%= method.code %></span><span class="method-check" aria-hidden="true">✓</span></span>
              <strong><%= method.name %></strong>
              <small><%= method.tagline %></small>
              <span class="method-vector">Vektor: <%= method.vector %></span>
            </button>
          <% }) %>
        </div>
      </section>
    </section>

    <section class="action-bar" id="action-bar">
      <div class="action-summary">
        <div class="summary-item"><span class="summary-label">TARGET</span><strong id="selected-target">Belum dipilih</strong></div>
        <span class="summary-arrow" aria-hidden="true">→</span>
        <div class="summary-item"><span class="summary-label">METODE</span><strong id="selected-method">Belum dipilih</strong></div>
      </div>
      <div class="action-buttons">
        <button class="btn btn-ghost" id="reset-selection" type="button">Reset pilihan</button>
        <button class="btn btn-launch" id="launch-button" type="button" disabled>Luncurkan serangan simulasi <span aria-hidden="true">↗</span></button>
      </div>
    </section>

    <section class="panel output-panel">
      <div class="panel-head">
        <div><span class="section-index">03 / KELUARAN</span><h2>Log deteksi &amp; respons</h2></div>
        <span class="panel-count" id="detection-count">0 ALERT</span>
      </div>
      <div class="output-body" id="output-body" aria-live="polite">
        <div class="output-empty" id="output-empty">Belum ada serangan diluncurkan. Pilih target dan metode, lalu tekan “Luncurkan”.</div>
        <ol class="log-list" id="log-list"></ol>
      </div>
    </section>

    <footer class="console-footer">
      <span>GARUDA SHIELD <b>·</b> RED TEAM SIMULATOR</span>
      <span>SELURUH SERANGAN, TARGET, DAN DETEKSI ADALAH DATA FIKTIF LOKAL</span>
      <form action="/demo/reset" method="post"><button class="btn btn-ghost" type="submit">Reset skenario</button></form>
    </footer>
  </main>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script src="/konsol.js" defer></script>
</body>
</html>